---
import Section from "./Section.astro";
import { BOOKING_URL, branches } from "../data/site";
const newTab = " (відкриється в новій вкладці)";
---
<Section id="branches" rec="UX-R07" class="branches">
  <div class="container">
    <h2 class="branches__title" data-reveal>Адреси, години й&nbsp;телефони</h2>
    <ul class="branch-list">
      {branches.map((b) => (
        <li class="branch" id={`branch-${b.id}`}>
          <h3 class="branch__street">{b.street}</h3>
          <p class="branch__note">{b.note}</p>
          <dl class="branch__hours tabular">
            <div><dt>Пн–Сб</dt><dd>{b.weekdays}</dd></div>
            <div><dt>Нд</dt><dd>{b.sunday}</dd></div>
          </dl>
          <p class="branch__sunday">{b.sundayOpen && <span class="mark mark--sunday" data-sunday>Єдина філія, відкрита в&nbsp;неділю</span>}</p>
          <p class="branch__phone tabular"><a href={`tel:${b.tel}`}>{b.phone}</a></p>
          <p class="branch__email"><a class="link" href={`mailto:${b.email}`}>{b.email}</a></p>
          <div class="branch__actions">
            <a class="btn btn--line" href={`tel:${b.tel}`} aria-label={`Подзвонити у філію на вулиці ${b.street}`}>Подзвонити</a>
            <a class="link" href={b.map} target="_blank" rel="noopener" data-rec="SP-R03">Маршрут<span class="visually-hidden"> до вулиці {b.street}{newTab}</span></a>
            <a class="link" href={BOOKING_URL} target="_blank" rel="noopener" data-rec="UX-R06">Записатися<span class="visually-hidden">{newTab}</span></a>
          </div>
        </li>
      ))}
    </ul>
  </div>
</Section>

<style>
  :global(.branches) { padding-block: var(--section-y-l) var(--section-y); }
  .branches__title { max-width: 16ch; }
  .branch-list { display: grid; gap: var(--space-xl); margin-top: var(--space-xl); }
  .branch { display: flex; flex-direction: column; gap: var(--space-xs); padding-top: var(--space-md); border-top: var(--border) solid var(--color-text); }
  .branch__street { font-size: var(--text-title); }
  .branch__note:empty, .branch__sunday:empty { display: none; }
  .branch__note { color: var(--color-muted); font-size: var(--text-sm); }
  .branch__hours { display: grid; gap: var(--space-3xs); margin-top: var(--space-2xs); }
  .branch__hours div { display: flex; gap: var(--space-sm); }
  .branch__hours dt { min-width: 4.5em; color: var(--color-muted); }
  .branch__sunday { font-weight: 600; }
  .mark--sunday::after { clip-path: inset(0 0 0 0); }
  :global(.js) .mark--sunday:not(.is-marked)::after { clip-path: inset(0 100% 0 0); }
  .mark--sunday.is-marked::after { transition-duration: var(--dur-long); }
  .branch__phone { margin-top: var(--space-2xs); font-size: var(--text-street); font-weight: 600; }
  .branch__phone a {
    display: inline-flex; align-items: center; min-height: var(--control-h-s);
    color: var(--color-text); text-decoration: none;
    transition: color var(--dur-micro) var(--ease-out);
  }
  .branch__phone a:hover { color: var(--color-primary); }
  .branch__phone a:active { color: var(--color-primary-hover); }
  .branch__email .link { font-weight: 400; display: inline-flex; align-items: center; min-height: var(--control-h-s); overflow-wrap: break-word; }
  .branch__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-xs) var(--space-md); margin-top: auto; padding-top: var(--space-sm); }
  .branch__actions .link { display: inline-flex; align-items: center; min-height: var(--control-h-s); white-space: nowrap; }

  @media (max-width: 39.99rem) {
    .branch__actions { display: grid; grid-template-columns: auto auto; justify-content: start; }
    .branch__actions .btn { grid-column: 1 / -1; }
  }
  @media (min-width: 60rem) {
    .branch__note:empty, .branch__sunday:empty { display: block; }
    .branch { display: grid; grid-template-rows: subgrid; grid-row: span 7; row-gap: var(--space-xs); }
    .branch__actions { margin-top: 0; align-self: end; }
    .branch-list { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gap-columns); margin-top: var(--space-2xl); }
  }
  @media (prefers-reduced-motion: reduce) {
    .mark--sunday.is-marked::after { transition: none; }
  }
</style>
