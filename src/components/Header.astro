---
import Logo from "./Logo.astro";
import FutureLink from "./FutureLink.astro";
import { BOOKING_URL, TELEGRAM_URL, VIBER_URL, FUTURE_NOTE, branches } from "../data/site";

interface Props { home?: string; }
const { home = "" } = Astro.props;
const anchors = [
  { href: home + "#services", id: "services", label: "Послуги" },
  { href: home + "#about", id: "about", label: "Про центр" },
  { href: home + "#booking", id: "booking", label: "Як записатися" },
  { href: home + "#branches", id: "branches", label: "Філії" },
];
const newTab = " (відкриється в новій вкладці)";
---
<header class="site-header" data-rec="UX-R03">
  <div class="container site-header__row">
    <Logo />
    <nav class="site-nav" aria-label="Головне меню">
      <ul class="site-nav__list">
        {anchors.map((a) => (
          <li><a class="site-nav__link mark" href={a.href} data-nav={a.id}>{a.label}</a></li>
        ))}
        <li><FutureLink note={FUTURE_NOTE} class="site-nav__future">Ціни</FutureLink></li>
        <li><FutureLink note={FUTURE_NOTE} class="site-nav__future">Акції</FutureLink></li>
      </ul>
    </nav>
    <div class="lang" role="group" aria-label="Мова сайту" data-rec="UX-R10">
      <span class="lang__current" aria-current="true" lang="uk">UA</span>
      <FutureLink note={FUTURE_NOTE} class="lang__item">RU</FutureLink>
      <FutureLink note={FUTURE_NOTE} class="lang__item future-link--end">EN</FutureLink>
    </div>
    <a class="btn site-header__cta" href={BOOKING_URL} target="_blank" rel="noopener">
      <span class="site-header__cta-long">Онлайн-запис</span><span class="site-header__cta-short" aria-hidden="true">Запис</span><span class="visually-hidden">{newTab}</span>
    </a>
    <button class="menu-btn" type="button" aria-haspopup="dialog" aria-controls="menu" aria-expanded="false" data-menu-open>
      <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h18M3 12h18M3 17h12" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" fill="none" /></svg>
      <span class="visually-hidden">Відкрити меню</span>
    </button>
  </div>
</header>

<dialog id="menu" class="menu on-field" aria-label="Меню сайту">
  <div class="menu__inner container">
    <div class="menu__top">
      <p class="menu__title">Меню</p>
      <button class="menu__close" type="button" data-dialog-close>Закрити</button>
    </div>
    <nav aria-label="Розділи сторінки">
      <ul class="menu__list">
        {anchors.map((a) => (
          <li><a class="menu__link mark" href={a.href} data-dialog-link>{a.label}</a></li>
        ))}
      </ul>
      <ul class="menu__future">
        <li><FutureLink note={FUTURE_NOTE}>Ціни</FutureLink></li>
        <li><FutureLink note={FUTURE_NOTE}>Акції</FutureLink></li>
        <li><FutureLink note={FUTURE_NOTE}>RU</FutureLink></li>
        <li><FutureLink note={FUTURE_NOTE} class="future-link--end">EN</FutureLink></li>
      </ul>
    </nav>
    <a class="btn menu__cta" href={BOOKING_URL} target="_blank" rel="noopener">Онлайн-запис<span class="visually-hidden">{newTab}</span></a>
    <ul class="menu__contacts" aria-label="Телефони філій">
      {branches.map((b) => (
        <li><a class="menu__contact" href={`tel:${b.tel}`}><span>{b.street}</span><span class="visually-hidden">, телефон </span> <span class="tabular">{b.phone}</span></a></li>
      ))}
    </ul>
    <ul class="menu__messengers" aria-label="Месенджери">
      <li><a class="link" href={TELEGRAM_URL} target="_blank" rel="noopener">Telegram<span class="visually-hidden">{newTab}</span></a></li>
    </ul>
  </div>
</dialog>

<style>
  .site-header {
    position: sticky; top: 0; z-index: var(--z-header);
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-rule);
  }
  .site-header__row { display: flex; align-items: center; gap: var(--space-sm); min-height: var(--header-h); }
  .site-header__row > :global(.logo) { margin-inline-end: auto; }
  .site-nav, .lang { display: none; }
  .site-header__cta { min-height: var(--control-h-s); padding-inline: var(--space-sm); white-space: nowrap; }
  .site-header__cta-long { display: none; }
  .menu-btn {
    display: none; align-items: center; justify-content: center;
    width: var(--control-h-s); height: var(--control-h-s);
    padding: 0; border: var(--border) solid var(--color-rule); border-radius: var(--radius);
    background: transparent; color: var(--color-text); cursor: pointer;
    transition: background-color var(--dur-micro) var(--ease-out), border-color var(--dur-micro) var(--ease-out);
  }
  .menu-btn:hover { background: var(--color-surface-2); border-color: var(--color-muted); }
  .menu-btn:active { background: var(--color-rule); }
  :global(.js) .menu-btn { display: inline-flex; }

  @media (min-width: 40rem) {
    .site-header__cta-long { display: inline; }
    .site-header__cta-short { display: none; }
    .site-header__cta { padding-inline: var(--space-md); }
  }
  @media (min-width: 75rem) {
    .site-header__row { gap: var(--space-lg); }
    .site-nav { display: block; }
    .site-nav__list { display: flex; align-items: center; gap: var(--space-md); }
    .site-nav__link { display: inline-flex; align-items: center; min-height: var(--control-h-s); color: var(--color-text); text-decoration: none; white-space: nowrap; transition: color var(--dur-micro) var(--ease-out); }
    .site-nav__link:hover { color: var(--color-primary); }
    .site-nav__link:active { color: var(--color-primary-hover); }
    .site-nav__link[aria-current="true"] { color: var(--color-primary); }
    .site-nav :global(.site-nav__future) { min-height: var(--control-h-s); }
    .lang { display: flex; align-items: center; gap: var(--space-xs); font-size: var(--text-sm); }
    .lang__current { color: var(--color-text); font-weight: 600; }
    .lang :global(.lang__item) { min-height: var(--control-h-s); }
    :global(.js) .menu-btn { display: none; }
  }

  /* Full-screen menu on the wine field */
  .menu {
    width: 100%; max-width: none; height: 100%; max-height: none;
    margin: 0; padding: 0; border: 0;
    background: var(--color-field); color: var(--color-on-field);
    overscroll-behavior: contain;
  }
  .menu[open] { animation: menu-in var(--dur-short) var(--ease-out); }
  .menu::backdrop { background: var(--color-scrim); }
  .menu__inner { display: flex; flex-direction: column; gap: var(--space-lg); padding-block: var(--space-sm) var(--space-xl); }
  .menu__top { display: flex; align-items: center; justify-content: space-between; min-height: var(--header-h); }
  .menu__title { font-size: var(--text-sm); color: var(--color-on-field-muted); }
  .menu__close {
    min-height: var(--control-h-s); padding: 0 var(--space-sm);
    border: var(--border) solid var(--color-on-field); border-radius: var(--radius);
    background: transparent; color: var(--color-on-field); font-weight: 600; cursor: pointer;
    transition: background-color var(--dur-micro) var(--ease-out), color var(--dur-micro) var(--ease-out);
  }
  .menu__close:hover { background: var(--color-on-field); color: var(--color-field); }
  .menu__close:active { transform: translateY(1px); }
  .menu__list { display: grid; gap: var(--space-2xs); }
  .menu__link {
    display: inline-flex; align-items: center; min-height: var(--control-h);
    font-family: var(--font-display); font-size: var(--text-section); line-height: var(--leading-tight); letter-spacing: var(--tracking-display);
    color: var(--color-on-field); text-decoration: none;
  }
  .menu__future { display: flex; flex-wrap: wrap; gap: var(--space-xs) var(--space-md); margin-top: var(--space-sm); }
  .menu__future :global(.future-link) { min-height: var(--control-h-s); }
  .menu__cta { align-self: flex-start; }
  .menu__contacts { display: grid; gap: var(--space-2xs); border-top: 1px solid var(--color-rule-field); padding-top: var(--space-md); }
  .menu__contact {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-3xs) var(--space-sm);
    min-height: var(--control-h); align-items: center;
    color: var(--color-on-field); text-decoration: none;
  }
  .menu__contact:hover { color: var(--color-accent); }
  .menu__contact span:first-child { color: var(--color-on-field-muted); }
  .menu__messengers { display: flex; gap: var(--space-lg); }
  .menu__messengers a { display: inline-flex; align-items: center; min-height: var(--control-h-s); }
  @keyframes menu-in { from { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .menu[open] { animation: none; }
    .menu__close:active { transform: none; }
  }
</style>
